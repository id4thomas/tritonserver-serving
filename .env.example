# Copy to .env and adjust. Both deploy.sh and serve.sh source it; real environment
# variables take precedence over the values set here.

# conda environment used to run scripts/deploy.py
CONDA_ENV=hf

# tritonserver image used by serve.sh
TRITONSERVER_IMAGE=nvcr.io/nvidia/tritonserver:26.06-py3

# staging output / mount source (default: <repo>/model_repository)
# MODEL_REPOSITORY=/home/yrlab/git/tritonserver-serving/model_repository

# host ports
HTTP_PORT=8000
GRPC_PORT=8001
METRICS_PORT=8002

# docker resources
GPUS=all
SHM_SIZE=8g
