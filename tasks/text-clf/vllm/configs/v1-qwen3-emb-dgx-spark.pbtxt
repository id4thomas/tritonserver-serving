name: "text-classification"
backend: "python"
max_batch_size: 256
dynamic_batching { }

version_policy: { specific: { versions: [1]}}
input [
  {
    name: "text"
    data_type: TYPE_STRING
    dims: [ -1 ] 
  }
]
output [
  {
    name: "label"
    data_type: TYPE_INT32
    dims: [ -1 ] # (batch_size, )
  },
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [ -1, -1 ] # (batch_size, num_classes)
  }
]

# VENV
parameters: {
  key: "EXECUTION_ENV_PATH"
  value: {string_value: "/tmp/venv.tar.gz"}
}


# Model Parameters
parameters: {
  key: "VLLM_MAX_MODEL_LEN",
  value: { string_value: "512" }
}
parameters: {
  key: "VLLM_MAX_MODEL_LEN_OFFSET",
  value: { string_value: "16" }
}
parameters: {
  key: "VLLM_MAX_NUM_SEQS",
  value: { string_value: "8" }
}
parameters: {
  key: "VLLM_DTYPE",
  value: { string_value: "auto" }
}
parameters: {
  key: "VLLM_GPU_MEMORY_UTILIZATION",
  value: { string_value: "0.08" }
}
parameters: {
  key: "VLLM_ADDITIONAL_OPTIONS",
  value: { string_value: "{}" }
}
parameters: {
  key: "TOKENIZER_PADDING_SIDE",
  value: { string_value: "left" }
}

